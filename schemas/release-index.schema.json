{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/petrolpram/737NG-Updates/main/schemas/release-index.schema.json",
  "title": "LevelUp 737NG Release Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "repository",
    "releaseVersion",
    "releaseSequence",
    "releaseTag",
    "releaseChannel",
    "publishedAt",
    "restartRequired",
    "checksumsFile",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "const": "levelup-737ng"
    },
    "repository": {
      "const": "petrolpram/737NG-Updates"
    },
    "releaseVersion": {
      "$ref": "#/$defs/version"
    },
    "releaseSequence": {
      "type": "integer",
      "minimum": 1
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[^/\\\\]+$"
    },
    "releaseChannel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimumToolkitVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "restartRequired": {
      "const": true
    },
    "checksumsFile": {
      "const": "SHA256SUMS.txt"
    },
    "releaseNotesUrl": {
      "type": "string",
      "format": "uri"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "baselineReleaseTag": {
      "type": "string",
      "pattern": "^v[^/\\\\]+$",
      "description": "Optional older release containing the full baseline for a delta-only release. Requires Toolkit 0.13.8 or newer; nested references are not supported."
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "assetFileName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\:]+$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageType",
        "releaseVersion",
        "manifestFile",
        "manifestSha256",
        "archiveFile",
        "archiveSize",
        "archiveSha256"
      ],
      "properties": {
        "packageType": {
          "enum": [
            "full",
            "cumulativePatch"
          ]
        },
        "releaseVersion": {
          "$ref": "#/$defs/version"
        },
        "baselineVersion": {
          "$ref": "#/$defs/version"
        },
        "baselineAliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          },
          "uniqueItems": true
        },
        "manifestFile": {
          "$ref": "#/$defs/assetFileName"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "archiveFile": {
          "$ref": "#/$defs/assetFileName"
        },
        "archiveSize": {
          "type": "integer",
          "minimum": 0
        },
        "archiveSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "packageType": {
                "const": "cumulativePatch"
              }
            },
            "required": [
              "packageType"
            ]
          },
          "then": {
            "required": [
              "baselineVersion",
              "baselineAliases"
            ]
          }
        }
      ]
    }
  }
}
